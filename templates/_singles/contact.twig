{# Contactpagina: vervangt page-contact.php #}
{% extends '_layouts/base' %}

{% set columns = 'mt-9 grid w-full grid-cols-1 gap-8 md:grid-cols-2' %}

{% block content %}
    <section class="section bg-navy pt-[148px] text-cream">
        {% include '_partials/section-title' with { title: entry.title } only %}
        <div class="flex flex-col items-center gap-9">
            <div class="{{ columns }}">
                <div class="mb-[1rem] flex w-full flex-wrap items-start gap-6 md:mb-6 xl:gap-8">
                    <h1 class="text-slate">{{ 'Benieuwd naar meer?'|t }}</h1>
                </div>
                <div class="rich-text">
                    {{ entry.bodyText }}
                </div>
            </div>
            {% include '_partials/icons/water' %}
        </div>
        <div class="flex flex-col items-center gap-9">
            <div class="{{ columns }}">
                <div>
                    {% include '_partials/address' %}
                </div>
                <div>
                    {% include '_partials/forms/contact' %}
                </div>
            </div>
        </div>
    </section>
    {% include '_blocks/wapenveld' %}
{% endblock %}
