{#
 # "Waar te koop?": kaart met verkooppunten.
 # De locaties komen uit het kaartveld (Maps-plugin) van de sectie Verkooppunten;
 # de kaart zelf wordt getekend met Leaflet + OpenStreetMap-kaarttegels (geen API-key nodig).
 #}
{% set stores = craft.entries.section('stores').orderBy('title asc').all() %}
{% set locaties = [] %}
{% for store in stores %}
    {% set location = store.storeLocation %}
    {% if location and location.lat is not null and location.lng is not null %}
        {% set locaties = locaties|merge([{
            naam: store.title,
            adres: location.address,
            lat: location.lat,
            lng: location.lng,
        }]) %}
    {% endif %}
{% endfor %}

<section class="section bg-navy text-cream" id="google-maps-kaart">
    {% include '_partials/section-title' with { title: 'Verkooppunten'|t } only %}

    {% if locaties|length %}
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
            integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">

        <div class="flex w-full flex-col gap-6 lg:flex-row lg:items-stretch">
            <div id="map" class="z-0 h-[400px] w-full overflow-hidden rounded-card lg:h-[480px] lg:flex-2" aria-label="{{ 'Kaart met verkooppunten'|t }}"></div>

            <div class="flex flex-col gap-4 lg:flex-1">
                <ul class="flex max-h-[400px] flex-col gap-2 overflow-y-auto">
                    {% for locatie in locaties %}
                        <li>
                            <button type="button" data-store="{{ loop.index0 }}"
                                class="flex w-full cursor-pointer flex-col gap-1 rounded-card bg-cream/8 px-4 py-3 text-left font-body text-body text-cream transition-colors duration-200 ease-in-out hover:bg-cream/18 focus-visible:bg-cream/18 focus-visible:outline-none">
                                <span class="font-body-bold text-ui">{{ locatie.naam }}</span>
                                {% if locatie.adres %}<span class="opacity-70">{{ locatie.adres }}</span>{% endif %}
                                <span class="opacity-70 empty:hidden" id="afstandLocatie{{ loop.index0 }}"></span>
                            </button>
                        </li>
                    {% endfor %}
                </ul>
                <button type="button" class="btn btn-primary" id="map-distance-btn" hidden>{{ 'Toon afstand vanaf mijn locatie'|t }}</button>
            </div>
        </div>

        <script>
            window.locaties = {{ locaties|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP'))|raw }};
            window.mapLabels = {{ {
                afstand: 'Afstand'|t,
                route: 'Route plannen'|t,
                geenLocatie: 'Je locatie kon niet worden bepaald.'|t,
            }|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP'))|raw }};
        </script>
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
        <script src="{{ alias('@web/js/map.js') }}?v=3.1.0"></script>
    {% else %}
        <p class="text-center opacity-20">{{ 'Binnenkort vind je hier onze verkooppunten.'|t }}</p>
    {% endif %}
</section>
