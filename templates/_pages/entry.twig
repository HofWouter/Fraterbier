{# Algemene pagina (o.a. "Ons verhaal"): vervangt index.php #}
{% extends '_layouts/base' %}

{% block content %}
    {% set image = entry.featuredImage.one() ?? null %}
    {% set imageClass = 'h-[250px] w-full object-cover sm:h-[310px] md:h-[470px] lg:h-[500px]' %}

    <section class="section bg-cream pt-0 text-navy">
        <div>
            {% if image %}
                <img class="{{ imageClass }}" src="{{ image.url }}" alt="{{ image.alt ?? entry.title }}">
            {% else %}
                <img class="{{ imageClass }}" src="{{ alias('@web/assets/images/voorbeeld_afbeelding.png') }}" alt="">
            {% endif %}
        </div>
        <div class="flex flex-col items-center gap-9">
            <div class="mt-9 grid w-full grid-cols-1 gap-8 md:grid-cols-2">
                <div class="mb-[1rem] flex w-full flex-wrap items-start gap-6 md:mb-6 xl:gap-8">
                    <h1 class="text-slate">{{ entry.title }}</h1>
                </div>
                <div class="rich-text">
                    {{ entry.bodyText }}
                </div>
            </div>
            {% include '_partials/icons/water' %}
        </div>
    </section>
{% endblock %}
