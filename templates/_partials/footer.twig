{# Footer: vervangt footer.php #}
{% set homeUrl = siteUrl() %}
{% set arrow %}<img src="{{ alias('@web/assets/arrow.svg') }}" alt="">{% endset %}

<footer class="bg-plum text-cream">
    <hr class="opacity-30">
    <div class="section w-full justify-between gap-8 py-12 xl:flex-row xl:items-center xl:gap-0">
        <div class="flex w-full justify-center xl:w-auto xl:justify-start">
            <a href="{{ homeUrl }}">
                <img src="{{ alias('@web/assets/frater_logo.png') }}" class="h-[130px] w-auto cursor-pointer" alt="Frater">
            </a>
        </div>
        <div class="flex flex-col items-start gap-8 md:flex-row md:justify-between">
            <div>
                <p class="opacity-30">{{ 'Ga snel naar'|t }}</p>
                <div class="flex w-full gap-4 xl:gap-8">
                    <div>
                        <a href="{{ homeUrl }}#onze-bieren-container" class="link"><span>{{ 'Onze bieren'|t }}</span>{{ arrow }}</a>
                        <a href="{{ onsVerhaal.url ?? homeUrl }}" class="link"><span>{{ 'Ons verhaal'|t }}</span>{{ arrow }}</a>
                    </div>
                    <div>
                        <a href="{{ homeUrl }}#google-maps-kaart" class="link"><span>{{ 'Waar te koop?'|t }}</span>{{ arrow }}</a>
                        <a href="{{ contact.url ?? homeUrl }}" class="link"><span>{{ 'Contact'|t }}</span>{{ arrow }}</a>
                    </div>
                </div>
            </div>
            <div>
                {% include '_partials/address' %}
            </div>
        </div>
    </div>
    <hr class="opacity-30">
    <div class="flex flex-col items-center justify-between px-6 lg:my-2 lg:flex-row lg:px-[8vw] [&_p]:mb-0">
        <a class="btn" href="https://www.brouwgildehulsbergen.nl/" target="_blank" rel="noopener">
            <img class="size-10" src="{{ alias('@web/assets/hulsbergen_logo.png') }}" alt="Brouwgilde Hulsbergen">
        </a>
        {% include '_partials/disclaimer-links' %}
    </div>
</footer>
