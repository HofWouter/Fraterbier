# Kopieer dit bestand naar .env en vul de waarden in.

CRAFT_APP_ID=
CRAFT_ENVIRONMENT=dev
CRAFT_SECURITY_KEY=

# Database
CRAFT_DB_DRIVER=mysql
CRAFT_DB_SERVER=127.0.0.1
CRAFT_DB_PORT=3306
CRAFT_DB_DATABASE=
CRAFT_DB_USER=
CRAFT_DB_PASSWORD=
CRAFT_DB_SCHEMA=
CRAFT_DB_TABLE_PREFIX=

# Gedrag (zet in productie DEV_MODE en ALLOW_ADMIN_CHANGES op false)
CRAFT_DEV_MODE=true
CRAFT_ALLOW_ADMIN_CHANGES=true
CRAFT_DISALLOW_ROBOTS=true

# Basis-URL van de Nederlandse (primaire) site, zonder slash aan het eind.
# De Deense site draait op /dk/.
PRIMARY_SITE_URL=https://frater.ddev.site

# Afzender van e-mails die Craft verstuurt
CRAFT_EMAIL_FROM=info@brouwgildehulsbergen.nl

# Ontvanger van het contact- en bestelformulier
CONTACT_FORM_TO_EMAIL=info@brouwgildehulsbergen.nl

