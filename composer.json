{
  "name": "wouterhof/frater",
  "description": "Website van Frater Bier, gebouwd op Craft CMS",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "craftcms/ckeditor": "^4.0",
    "craftcms/cms": "^5.5",
    "craftcms/contact-form": "^3.1",
    "ether/simplemap": "^5.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "modules\\": "modules/"
    }
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "yiisoft/yii2-composer": true
    },
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.2"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ]
  }
}
